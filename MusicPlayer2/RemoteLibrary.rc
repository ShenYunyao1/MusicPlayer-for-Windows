#include <windows.h>
#include <commctrl.h>
#include "RemoteLibraryResource.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
IDD_SERVER_SETTINGS DIALOGEX 0, 0, 360, 260
STYLE DS_SETFONT | WS_CHILD | WS_SYSMENU | WS_CLIPCHILDREN
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "Server URL (HTTP / HTTPS)", IDC_SERVER_URL_LABEL, 12, 12, 310, 12
    EDITTEXT IDC_SERVER_URL, 12, 28, 330, 18, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "API Key", IDC_SERVER_KEY_LABEL, 12, 54, 310, 12
    EDITTEXT IDC_SERVER_KEY, 12, 70, 330, 18, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Cache directory", IDC_SERVER_CACHE_LABEL, 12, 98, 310, 12
    EDITTEXT IDC_SERVER_CACHE, 12, 114, 330, 18, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "Test connection", IDC_SERVER_TEST, 12, 146, 100, 22
    LTEXT "", IDC_SERVER_STATUS, 12, 180, 330, 66
END

IDD_SERVER_LIBRARY DIALOGEX 0, 0, 510, 290
STYLE DS_SETFONT | WS_CHILD | WS_SYSMENU | WS_CLIPCHILDREN
FONT 9, "Microsoft YaHei UI"
BEGIN
    PUSHBUTTON "Refresh", IDC_SERVER_REFRESH, 8, 6, 64, 20
    PUSHBUTTON "Save playlist", IDC_SERVER_DOWNLOAD, 78, 6, 88, 20
    PUSHBUTTON "Play selected", IDC_SERVER_PLAY, 172, 6, 88, 20
    PUSHBUTTON "Settings", IDC_SERVER_CONFIGURE, 266, 6, 66, 20
    PUSHBUTTON "Cancel", IDC_SERVER_CANCEL, 338, 6, 64, 20
    LISTBOX IDC_SERVER_PLAYLISTS, 8, 34, 118, 188, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    CONTROL "", IDC_SERVER_TRACKS, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | WS_TABSTOP | WS_BORDER, 134, 34, 368, 188
    LTEXT "", IDC_SERVER_NOTES, 8, 226, 494, 30
    LTEXT "", IDC_SERVER_STATUS, 8, 260, 494, 24
END
